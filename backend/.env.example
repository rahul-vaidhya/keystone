# Copy to .env for local dev. docker-compose.yml provisions Postgres+pgvector and Redis
# with the credentials below.

ENV=dev
LOG_LEVEL=INFO

# SPA dev server (comma-separated). Used for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — change JWT_SECRET before any real deployment.
JWT_SECRET=dev-only-change-me-use-32-chars-min!!
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Postgres (async driver). docker-compose exposes it on localhost:55432
# (non-default host port — avoids colliding with a native Windows Postgres install on 5432).
DATABASE_URL=postgresql+asyncpg://veratas:veratas@127.0.0.1:55432/veratas

# Redis (arq queue + public embed-widget rate limiting). docker-compose exposes it on
# localhost:6379.
REDIS_URL=redis://localhost:6379/0

# Comma-separated IPs of reverse proxies/load balancers in front of this app, if any.
# Empty (default) = trust nothing; the public embed chat endpoint's per-IP rate limit
# uses the raw socket peer address, which is CORRECT for local dev / direct connections
# but WRONG behind a real proxy (every visitor's request would appear to come from the
# proxy's own address, collapsing per-IP limiting to one shared bucket). Set this to
# your proxy's address(es) in any proxied deployment. See app/utils/http.py:get_client_ip.
TRUSTED_PROXY_IPS=

# Tenancy: enforced RLS is DESIGNED now, switched on in Phase 6. Keep OFF in dev/test.
RLS_ENABLED=false

# Seam adapters: fake | real, one switch per seam (F23 — was a single SEAMS_MODE before).
PARSER_MODE=real
EMBEDDER_MODE=real
LLM_MODE=real

# Real Embedder/LLM (OpenAI-compatible API). Only needed if EMBEDDER_MODE/LLM_MODE=real.
# REQUIRED for real mode: paste your OpenRouter key (https://openrouter.ai/keys) here AND in
# OPENROUTER_API_KEY below. Without a key, set the three *_MODE lines above to fake.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Real Parser (F23, OpenRouter file-parser plugin). Only needed if PARSER_MODE=real.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PARSER_MODEL=openai/gpt-4o-mini
PARSER_OCR_FALLBACK_MIN_CHARS_PER_PAGE=20

# Object store (F05): r2 | local. Default r2 (production). Set local for a fully-offline
# run with no cloud creds — selects LocalDiskObjectStore, shared by the API and the worker.
STORAGE_MODE=local
STORAGE_LOCAL_ROOT=./.localstorage

# Cloudflare R2 (S3-compatible object store; used when STORAGE_MODE=r2). Unset in dev.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Embed widget (docs/embed-widget-plan.md). PUBLIC_APP_URL is the base URL of the
# DEPLOYED FRONTEND SPA (not this backend) — every widget's admin-facing embed
# snippet/iframe URL is built from it. Defaults to the local Vite dev server, which is
# correct here but WRONG in production: set it to your real frontend origin before
# any real deployment, or every generated snippet will point at localhost.
PUBLIC_APP_URL=http://localhost:5173
# Redis sliding-window rate limits on the PUBLIC (unauthenticated) embed chat endpoint.
WIDGET_RATE_LIMIT_PER_MINUTE=30
WIDGET_IP_RATE_LIMIT_PER_MINUTE=10

# Hybrid search (BM25 + vector, RRF fusion). Off by default.
HYBRID_SEARCH_ENABLED=true
HYBRID_CANDIDATE_K=25
# From-scratch sparse IR lexical channel: off | tfidf | bm25. Only takes effect when
# HYBRID_SEARCH_ENABLED=true — it REPLACES hybrid search's Postgres tsvector/ts_rank
# lexical channel with the in-house inverted index (app/services/retrieval/sparse/:
# Porter-stemmed positional zone index, SMART lnc.ltc tf-idf or Okapi BM25). It is never
# used as a standalone retriever. RRF fusion, reranker and confidence gate are unchanged.
SPARSE_RETRIEVAL_MODE=bm25
# Zone weight of a chunk's section heading relative to its body (body weight = 1.0).
SPARSE_HEADING_ZONE_WEIGHT=2.0

# Per-sentence citation checker: scores each answer sentence against the chunks it cites
# (tf-idf cosine via the sparse index + embedding cosine, averaged). Off by default.
CITATION_CHECK_ENABLED=true
# Combined-score threshold for "supported" (below = "weak"). Heuristic default, tune it.
CITATION_SUPPORT_THRESHOLD=0.33

# Demo features (all used in the report and the video)
ENRICHMENT_ENABLED=true
BROAD_QUERY_ENABLED=true
NOTEBOOK_OVERVIEW_ENABLED=true
SEMANTIC_OUTLINE_ENABLED=true
