# Copy to .env for local dev. docker-compose.yml provisions Postgres+pgvector and Redis
# with the credentials below.

ENV=dev
LOG_LEVEL=INFO

# SPA dev server (comma-separated). Used for CORS.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth — change JWT_SECRET before any real deployment.
JWT_SECRET=dev-only-change-me-use-32-chars-min!!
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# Postgres (async driver). docker-compose exposes it on localhost:55432
# (non-default host port — avoids colliding with a native Windows Postgres install on 5432).
DATABASE_URL=postgresql+asyncpg://veratas:veratas@127.0.0.1:55432/veratas

# Redis (arq queue). docker-compose exposes it on localhost:6379.
REDIS_URL=redis://localhost:6379/0

# Tenancy: enforced RLS is DESIGNED now, switched on in Phase 6. Keep OFF in dev/test.
RLS_ENABLED=false

# Seam adapters: fake | real, one switch per seam (F23 — was a single SEAMS_MODE before).
PARSER_MODE=fake
EMBEDDER_MODE=fake
LLM_MODE=fake

# Real Embedder/LLM (OpenAI-compatible API). Only needed if EMBEDDER_MODE/LLM_MODE=real.
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini

# Real Parser (F23, OpenRouter file-parser plugin). Only needed if PARSER_MODE=real.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
PARSER_MODEL=openai/gpt-4o-mini
PARSER_OCR_FALLBACK_MIN_CHARS_PER_PAGE=20

# Cloudflare R2 (S3-compatible object store). Unset in dev; wired in Phase 1+.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
