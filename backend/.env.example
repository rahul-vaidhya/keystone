# Copy to .env for local dev. docker-compose.yml provisions Postgres+pgvector and Redis
# with the credentials below.

ENV=dev
LOG_LEVEL=INFO

# Postgres (async driver). docker-compose exposes it on localhost:5432.
DATABASE_URL=postgresql+asyncpg://veratas:veratas@localhost:5432/veratas

# Redis (arq queue). docker-compose exposes it on localhost:6379.
REDIS_URL=redis://localhost:6379/0

# Tenancy: enforced RLS is DESIGNED now, switched on in Phase 6. Keep OFF in dev/test.
RLS_ENABLED=false

# Seam adapters: fake | real. Real adapters land in F03 (vendor still TBD).
SEAMS_MODE=fake

# Cloudflare R2 (S3-compatible object store). Unset in dev; wired in Phase 1+.
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
